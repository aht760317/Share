<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>薪資明細表</title>
    <style>
        body {
            font-family: 'Microsoft JhengHei', Arial, sans-serif;
            background-color: #555;
            margin: 0;
            padding: 20px;
        }
        .payslip-container {
            width: 700px;
            margin: 0 auto 30px auto;
            background: #ffffff;
            border: 2px solid #000;
            padding: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }
        .header-title {
            text-align: center;
            font-size: 1.2em;
            font-weight: bold;
            background-color: #ffff00; /* 對應截圖中的黃色標題 */
            border: 1px solid #000;
            padding: 5px;
            margin-bottom: 5px;
        }
        .sub-header {
            display: flex;
            justify-content: space-between;
            padding: 5px;
            border: 1px solid #000;
            border-top: none;
            font-size: 0.95em;
        }
        table.slip-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
            font-size: 0.9em;
        }
        table.slip-table th, table.slip-table td {
            border: 1px solid #000;
            padding: 4px 6px;
            text-align: left;
        }
        .section-tag {
            background-color: #ffff00;
            text-align: center;
            font-weight: bold;
            width: 30px;
        }
        .text-right {
            text-align: right;
        }
        .text-center {
            text-align: center;
        }
        .signature-section {
            border: 1px solid #000;
            border-top: none;
            padding: 15px 10px;
            text-align: center;
            font-weight: bold;
        }
        .print-btn-container {
            text-align: center;
            margin-bottom: 40px;
        }
        .print-btn {
            background-color: #4CAF50;
            color: white;
            padding: 10px 25px;
            font-size: 1.1em;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }
        .print-btn:hover {
            background-color: #45a049;
        }
        @media print {
            body {
                background-color: #fff;
                padding: 0;
            }
            .payslip-container {
                border: 1px solid #000;
                box-shadow: none;
                margin: 0;
                page-break-after: always;
            }
            .print-btn-container {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- 單張薪資條 -->
    <div class="payslip-container">
        <!-- 機構與日期 -->
        <div class="header-title">顧德文教機構</div>
        <div class="sub-header">
            <span>姓名：陳怡芳</span>
            <span>日期：112年5月10日</span>
        </div>
        <div class="sub-header" style="border-top: none;">
            <span>今年累計請假：婚假: 事假:</span>
            <span>112年4月份薪俸明細表</span>
        </div>

        <!-- 薪資明細表格 -->
        <table class="slip-table">
            <tr>
                <td colspan="2">遲到: 分, 無打卡:</td>
                <td colspan="2">到職日：103/7/1</td>
            </tr>
            <tr>
                <td rowspan="12" class="section-tag">薪轉</td>
                <td>本薪</td>
                <td class="text-right" colspan="2">26400</td>
            </tr>
            <tr>
                <td>勞健保</td>
                <td colspan="2" class="text-center">5月(個人負擔)</td>
            </tr>
            <tr>
                <td>勞保(-)</td>
                <td class="text-right">公司 2218</td>
                <td class="text-right">634</td>
            </tr>
            <tr>
                <td>健保(-)</td>
                <td class="text-right">公司 1286</td>
                <td class="text-right">409</td>
            </tr>
            <tr>
                <td>福利金(-)</td>
                <td class="text-right" colspan="2">職保 53</td>
            </tr>
            <tr>
                <td>勞退金</td>
                <td class="text-right" colspan="2">公司 1584</td>
            </tr>
            <tr>
                <td>其它(-)</td>
                <td class="text-right">眷屬(1位)</td>
                <td class="text-right">205</td>
            </tr>
            <tr>
                <td>應領金額</td>
                <td class="text-right">4548</td>
                <td class="text-right">25152</td>
            </tr>
            <tr>
                <td colspan="3" style="background-color: #f9f9f9; font-weight: bold;">加給金額</td>
            </tr>
            <tr>
                <td>年資津貼</td>
                <td class="text-right" colspan="2"></td>
            </tr>
            <tr>
                <td>其它加給</td>
                <td class="text-right" colspan="2">2600</td>
            </tr>
            <tr>
                <td>特殊加給</td>
                <td class="text-right" colspan="2">1000</td>
            </tr>
            <!-- 授課細節 -->
            <tr>
                <td class="text-center">班級名稱</td>
                <td class="text-center">人數</td>
                <td class="text-center">授課/帶班</td>
                <td class="text-center">堂數</td>
            </tr>
            <tr>
                <td>數學課</td>
                <td></td>
                <td class="text-right">看班 2000</td>
                <td></td>
            </tr>
            <!-- 勞健保投保級距對照區 -->
            <tr>
                <td colspan="2" style="background-color: #ffff00;">勞健保 個人負擔</td>
                <td colspan="2" style="background-color: #ffff00;" class="text-right">973</td>
            </tr>
            <tr>
                <td colspan="2" style="background-color: #ffff00;">勞健保 公司負擔</td>
                <td colspan="2" style="background-color: #ffff00;" class="text-right">5141</td>
            </tr>
            <tr>
                <td>應領金額</td>
                <td colspan="3" class="text-right">30000</td>
            </tr>
            <tr>
                <td>總領金額</td>
                <td colspan="3" class="text-right">35000</td>
            </tr>
        </table>

        <!-- 簽章區 -->
        <div class="signature-section">
            領款人簽章：
        </div>
    </div>

    <!-- 列印按鈕 -->
    <div class="print-btn-container">
        <button class="print-btn" onclick="window.print()">列印此薪資明細表</button>
    </div>

</body>
</html>
